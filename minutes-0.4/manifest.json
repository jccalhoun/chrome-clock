{
  "manifest_version": 3,
  "name": "Clock Minutes",
  "description": "Shows the minutes with options shared with Clock Hours",
  "version": "0.4.1",
  "key": "",
  "icons": {
    "48": "icon48.png",
    "96": "icon96.png"
  },
  "background": {
    "service_worker": "background_script.js"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "Clock Minutes"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "externally_connectable": {
    "ids": [
      "mfjklceejmahbgomlppgndjldghhkhfo"
    ]
  }
}
